generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Declaración de los enums para los esquemas User y Course
enum Role {
  ADMIN
  INSTRUCTOR
  ESTUDIANTE
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

//Declaración de los respectivos esquemas para la base de datos
//Declaración esquema User
model User {
  id        String   @id
  name      String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())

  // Relaciones
  courses      Course[]     @relation("InstructorCourses")
  enrollments  Enrollment[]
}

//Declaración esquema Course
model Course {
  id           String       @id
  title        String
  description  String?
  level        CourseLevel
  instructorId String
  createdAt    DateTime     @default(now())

  // Relaciones
  instructor   User         @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: Restrict)
  enrollments  Enrollment[]
}

//Declaración esquema Enrollment
model Enrollment {
  id         String   @id
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())

  // Relaciones
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Evitar duplicados
  @@unique([userId, courseId])
}
